# ═══════════════════════════════════════════════════════
#  SIGNA STUDIO PRINT — .htaccess
#  Se activează DOAR pe host Apache (nu are efect pe GitHub Pages).
# ═══════════════════════════════════════════════════════

# ── Pagina de eroare 404 ───────────────────────────────
ErrorDocument 404 /404.html

# ── Blocare listare directoare ─────────────────────────
Options -Indexes

# ── Protejare fișiere sensibile ────────────────────────
<FilesMatch "(^\.|\.(htaccess|htpasswd|json|md|log)$)">
  Require all denied
</FilesMatch>
# Excepție: manifestul trebuie servit
<Files "site.webmanifest">
  Require all granted
</Files>

# Blochează accesul direct la folderul de rate limiting
RedirectMatch 403 ^/php/tmp/.*$

# ── Compresie GZIP ─────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>

# ── Cache browser ──────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ── Headers de securitate ──────────────────────────────
<IfModule mod_headers.c>
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # Content Security Policy — ajustat pentru Google Fonts + JSON-LD.
  # Adaugă www.googletagmanager.com / www.google-analytics.com când activezi Analytics.
      # Fonturile vin de la Fontshare (Satoshi + Cabinet Grotesk).
    # ⚠️ Dacă activezi Google Analytics (ANALYTICS_ID în js/cookie.js),
    # adaugă în script-src și connect-src:
    #   https://www.googletagmanager.com https://www.google-analytics.com
    # Altfel CSP-ul blochează scriptul și Analytics nu funcționează.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://api.fontshare.com; font-src 'self' https://cdn.fontshare.com; img-src 'self' data:; connect-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"

  # ── HSTS — DECOMENTEAZĂ DOAR DUPĂ CE SSL E ACTIV ─────
  # Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# ── Redirect HTTPS + www → non-www ─────────────────────
# DECOMENTEAZĂ pe host, după ce certificatul SSL funcționează.
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   # Forțează HTTPS
#   RewriteCond %{HTTPS} off
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
#   # www → non-www
#   RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
#   RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
# </IfModule>

# ── PROTECȚIE SUPLIMENTARĂ (adăugat v2.2.0) ────────────
# config.php se include din contact.php, nu se accesează direct.
# Are deja ghidul `if (!defined('APP')) die();`, dar blocăm și la server.
<Files "config.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

# Resursele sunt versionate prin ?v=, deci pot fi cache-uite agresiv.
# ⚠️ Obligatoriu: incrementează ?v= în TOATE paginile la orice modificare
# de CSS/JS, altfel vizitatorii rămân cu versiunea veche.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|jpg|jpeg|png|webp|svg|ico|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(html|json)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>
